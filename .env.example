# ============================================================
# A2A Hub 环境变量示例 —— 复制为 .env 后按需填写
# 只填你要用的厂商即可，未配置的适配器会自动标记为 unavailable
# ============================================================

# ---------- Hub 自身 ----------
A2A_HOST=0.0.0.0
A2A_PORT=8080
# Hub 对外可达地址，会写进 Agent Card 的 url 字段（远程 agent 靠它回调）
A2A_PUBLIC_URL=http://localhost:8080
A2A_HUB_NAME=A2A Hub
# 任务存储：memory | sqlite
A2A_STORE=memory
A2A_DB_PATH=./data/a2a_hub.db
# 全局任务超时（秒）
A2A_TASK_TIMEOUT=300
A2A_LOG_LEVEL=INFO

# ---------- 认证 ----------
# 留空 = 不校验（本地开发）。设置后，/rpc 需带 Authorization: Bearer <token>
A2A_API_TOKEN=
# 是否强制校验（true 时 A2A_API_TOKEN 为空则启动报错，建议生产开启）
A2A_REQUIRE_AUTH=false

# ---------- 配置文件 ----------
# 声明各 agent 的 YAML 路径
A2A_AGENTS_FILE=./config/agents.yaml

# ============================================================
# 各厂商凭证（供 agents.yaml 中 ${VAR} 占位符引用）
# ============================================================

# --- 阿里云通义千问 / 千问办公（DashScope OpenAI 兼容模式）---
DASHSCOPE_API_KEY=

# --- 字节跳动扣子 Coze ---
COZE_API_TOKEN=
COZE_BOT_ID=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Moonshot / Kimi ---
MOONSHOT_API_KEY=

# --- 智谱 GLM ---
ZHIPU_API_KEY=

# --- 通用兜底：任意 OpenAI 兼容网关 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 本地 CLI Agent ----------
# 指定可执行文件路径（不在 PATH 时填写完整路径）
CLAUDE_CLI=claude
CODEX_CLI=codex
WORKBUDDY_CLI=workbuddy
GEMINI_CLI=gemini
# CLI 单次调用超时（秒）
A2A_CLI_TIMEOUT=180
