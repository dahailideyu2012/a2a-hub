# ============================================================
# A2A Hub 环境变量示例 —— 复制为 .env 后按需填写
# 只填你要用的厂商即可，未配置的适配器会自动标记为 unavailable
# ============================================================

# ---------- Hub 自身 ----------
A2A_HOST=0.0.0.0
A2A_PORT=8080
# Hub 对外可达地址，会写进 Agent Card 的 url 字段（远程 agent 靠它回调）
A2A_PUBLIC_URL=http://localhost:8080
A2A_HUB_NAME=A2A Hub
# 任务存储：memory | sqlite
A2A_STORE=memory
A2A_DB_PATH=./data/a2a_hub.db
# 全局任务超时（秒）
A2A_TASK_TIMEOUT=300
A2A_LOG_LEVEL=INFO

# ---------- 认证 ----------
# 留空 = 不校验（本地开发）。设置后，/rpc 等接口需带 Authorization: Bearer <token>
A2A_API_TOKEN=
# 是否强制校验（true 时 A2A_API_TOKEN 为空则启动报错，建议生产开启）
A2A_REQUIRE_AUTH=false

# ---------- 社交层（加好友才能交流）----------
# 成员表路径。**文件不存在 = 门禁整体关闭**，行为与 v0.3.0 逐字节一致。
# 启用方式：cp config/members.example.yaml config/members.yaml
A2A_MEMBERS_FILE=./config/members.yaml
# 关系与好友。运行时状态，由程序读写，不要手编。
A2A_RELATIONS_FILE=./data/relations.json
# off = 关闭门禁；soft = 非好友仅能 chat；strict = 非好友一律拒绝（默认）
A2A_SOCIAL_MODE=strict
# 调用社交工具时门禁还没开，是否自动一键启用（生成 members.yaml + 热启用，
# 不用重启）。默认 true；想强制「必须自己准备配置」就设 false。
A2A_SOCIAL_AUTOINIT=true
# 社交简报：执行前把「你是谁/好友列表/缺口信号协议」注入 agent 的 prompt。
# 让 WorkBuddy/Codex/Claude Code 等 prompt 型 agent 零改动获得社交感知。
A2A_SOCIAL_BRIEFING=true

# ---------- 自主交友（§6）----------
# 社交巡航总开关。**默认关**：开了才会有后台的「发现 → 打分 → 申请」。
# 成员还需在 members.yaml 里显式声明 `autonomy.request.enabled: true` 才会被巡航。
A2A_AUTONOMY_ENABLED=false
# 巡航轮询间隔（秒）
A2A_AUTONOMY_INTERVAL=300
# 每轮最多发起的自主申请数
A2A_AUTONOMY_PER_ROUND=2
# 每天最多发起的自主申请数（巡航侧硬预算）
A2A_AUTONOMY_DAILY=6

# ---------- 配置文件 ----------
# 声明各 agent 的 YAML 路径
A2A_AGENTS_FILE=./config/agents.yaml

# ============================================================
# 各厂商凭证（供 agents.yaml 中 ${VAR} 占位符引用）
# ============================================================

# --- 阿里云通义千问 / 千问办公（DashScope OpenAI 兼容模式）---
DASHSCOPE_API_KEY=

# --- 字节跳动扣子 Coze ---
COZE_API_TOKEN=
COZE_BOT_ID=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Moonshot / Kimi ---
MOONSHOT_API_KEY=

# --- 智谱 GLM ---
ZHIPU_API_KEY=

# --- 通用兜底：任意 OpenAI 兼容网关 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 本地 CLI Agent ----------
# 指定可执行文件路径（不在 PATH 时填写完整路径）
CLAUDE_CLI=claude
CODEX_CLI=codex
WORKBUDDY_CLI=workbuddy
GEMINI_CLI=gemini
# CLI 单次调用超时（秒）
A2A_CLI_TIMEOUT=180
