# Copy to deploy/test/.env.test and generate a unique random value.
# Do not commit the real .env.test file.
A2A_API_TOKEN=
A2A_TEST_PORT=18080

# Optional integrations remain disabled until separately configured.
A2A_CHATGPT_INGRESS_TOKEN=
A2A_CHATGPT_INGRESS_ACTOR=human:default
A2A_CHATGPT_INGRESS_ALLOWED_AGENTS=
A2A_WORKBUDDY_CONNECTOR_TOKEN=
A2A_WORKBUDDY_CONNECTOR_ALLOWED_AGENTS=
A2A_GITHUB_RELAY_HMAC_SECRET=
A2A_GITHUB_RELAY_API_TOKEN=
A2A_GITHUB_RELAY_ALLOWED_REPOS=
A2A_GITHUB_CALLBACK_OUTBOX_MAX_ATTEMPTS=12
A2A_GITHUB_CALLBACK_OUTBOX_POLL_SECONDS=2.0

# Keep local test deployments on the echo adapter unless explicitly changed.
