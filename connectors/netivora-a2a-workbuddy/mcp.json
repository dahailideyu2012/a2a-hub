{
  "mcpServers": {
    "netivora-a2a-workbuddy": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-c",
        "import os,runpy; runpy.run_path(os.environ['A2A_HUB_MCP_SERVER_PATH'], run_name='__main__')"
      ],
      "env": {
        "A2A_HUB_MCP_SERVER_PATH": "${A2A_HUB_MCP_SERVER_PATH}",
        "A2A_WORKBUDDY_HUB_URL": "${A2A_WORKBUDDY_HUB_URL}",
        "A2A_WORKBUDDY_CONNECTOR_TOKEN": "${A2A_WORKBUDDY_CONNECTOR_TOKEN}"
      },
      "timeout": 30000
    }
  }
}
